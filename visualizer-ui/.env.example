# Study harness environment variables.
# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# Next.js loads .env files from the project root (visualizer-ui/), not from src/.

# Required

# Supabase, SERVER-ONLY. These must NOT be prefixed with NEXT_PUBLIC_ so they are
# never sent to the browser. The service role key bypasses RLS and is used only
# by the API route handlers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile protects participant assignment from automated session
# creation. The site key is public; the secret key is SERVER-ONLY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-public-site-key
TURNSTILE_SECRET_KEY=your-server-only-secret-key

# Public Microsoft Forms questionnaire URL shown on the final handoff screen.
NEXT_PUBLIC_MSFORMS_URL=https://forms.office.com/your-form-link

# Researcher admin dashboard at /admin. SERVER-ONLY, no NEXT_PUBLIC_ prefix.
# ADMIN_SESSION_SECRET signs the admin session cookie: any long random string,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_EMAIL=researcher@example.edu
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Optional, development only

# Java tracer used by /api/trace (disabled in production builds).
# Defaults: JAVA_BIN is the JDK 21 path on the original dev machine,
# JAVA_JAIL_DIR is ../java-jail-spike.
# JAVA_BIN=/path/to/jdk-21/bin/java
# JAVA_JAIL_DIR=../java-jail-spike

# Base URL the db:smoke script calls. Defaults to http://localhost:3000.
# STUDY_APP_URL=http://localhost:3000
